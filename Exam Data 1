Create TRIGGER T1 on Orders After INSERT AS
Begin
Update o 
Set o.amt=i.qty*p.rate 
From Orders o, Products p, inserted i
WHERE p.sid=o.sid and p.sid=i.sid;
Update p
Set p.qty=p.qty-i.qty
From Products p, inserted i
Where p.sid=i.sid;
Update s
Set s.Sales_amt=s.Sales_amt+i.amt
From Salesperson s, inserted i
Where s.empno=i.empno;
END;

Create Trigger T2 on orders after Delete as 
Begin
Update p
Set p.qty=p.qty+d.qty
From products p, deleted d
Where p.sid=d.sid;
Update s
Set s.Sales_amt=s.Sales_amt-d.amt
From Salesperson s, Deleted d
Where s.empno=d.empno;
END;


